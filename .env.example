# Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Frontend & CORS
FRONTEND_URL=https://your-frontend.onrender.com
ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://techonline.edu.vn

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_SECURE=true

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
CONTACT_US_EMAIL=contact@example.com

# Banking / Token (Optional)
VIETIN_BANK=
TOKEN=
BACKEND_URL=https://your-backend.onrender.com
